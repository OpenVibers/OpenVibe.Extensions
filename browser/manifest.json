{
  "manifest_version": 3,
  "name": "OpenVibe Companion",
  "short_name": "OpenVibe",
  "version": "0.8.0",
  "key": "",
  "description": "Coupon codes for the shop you are on, tried in its coupon box when you ask; the same restaurant on every delivery app; a review site's rating saved to OpenVibe.Reviews; and one click to keep a rental listing on your OpenVibe.Rent board or watch a page. The OpenVibe Dock sits in the side panel, on every site. Reads the tab only when you open it.",
  "homepage_url": "https://github.com/OpenVibers/OpenVibe.Extensions",
  "author": "OpenVibers",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "OpenVibe Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "open_in_sidebar": true
  },
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://openvibe.coupons/*",
    "https://openvibe.network/*",
    "https://openvibe.chat/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://openvibe.coupons https://openvibe.network https://openvibe.chat; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "114",
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@openvibe.network",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  }
}
