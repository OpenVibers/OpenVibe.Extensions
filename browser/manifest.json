{
  "manifest_version": 3,
  "name": "OpenVibe Coupons Helper",
  "short_name": "OV Coupons",
  "version": "0.1.0",
  "description": "Shows the coupon codes OpenVibe.Coupons knows for the shop you are on, with their status, expiry and restrictions. Reads only the hostname, only when you open it.",
  "homepage_url": "https://openvibe.coupons/connect-extension",
  "author": "OpenVibers",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Coupon codes for this shop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://openvibe.coupons/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://openvibe.coupons; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "coupons-helper@openvibe.network",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
